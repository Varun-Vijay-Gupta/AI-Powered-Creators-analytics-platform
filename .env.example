# Server
PORT=3001
CLIENT_URL=http://localhost:5173

# Postgres (matches docker-compose defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/video_rag

# Qdrant (matches docker-compose defaults)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=video_chunks

# Required — Google AI Studio (free tier available)
GEMINI_API_KEY=

# Optional — only if you want OpenAI cloud Whisper instead of local
# OPENAI_API_KEY=

# Local embeddings (FastEmbed / BGE — no API key, runs on CPU)
EMBEDDING_MODEL=bge-small-en-v1.5
EMBEDDING_CACHE_DIR=./.embedding-cache

# Optional
WHISPER_MODEL=whisper-1
WHISPER_LOCAL_MODEL=tiny
TMP_DIR=./tmp
# YT_DLP_PATH=C:\path\to\yt-dlp.exe
# FFMPEG_PATH=C:\path\to\ffmpeg\bin
